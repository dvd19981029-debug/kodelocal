// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?   @default("folder")
  color       String?   @default("#6366f1")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String          @id @default(cuid())
  sku                String?         @unique // Código de esencia (ej. 100, 101)
  barcode            String?         @unique
  name               String          // Nombre del contratipo (ej. 1 Million Elixir H)
  brand              String?         // Marca inspirada (ej. Paco Rabanne, Carolina Herrera)
  gender             String?         // Caballero, Dama, Unisex, Niños
  unit               String?         @default("Onza") // Onza, Unidad, Paquete, Litro
  description        String?
  price              Decimal         @db.Decimal(10, 2) @default(3.25) // Precio venta ($3.25 para esencias)
  cost               Decimal?        @db.Decimal(10, 2) @default(1.95) // Costo compra ($1.95 para esencias)
  stock              Int             @default(50)
  minStock           Int             @default(10)
  imageUrl           String?
  isActive           Boolean         @default(true)
  isAvailableOnline  Boolean         @default(true)
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id])
  saleItems          SaleItem[]
  stockMovements     StockMovement[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@index([brand])
  @@index([gender])
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  documentType String?   @default("DUI")
  documentNum  String?
  nrc          String?
  businessName String?
  activityCode String?
  activityDesc String?
  email        String?   @unique
  phone        String?
  address      String?
  department   String?
  municipality String?
  passwordHash String?
  googleId     String?
  avatarUrl    String?
  sales        Sale[]
  credits      CustomerCredit[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentNum])
  @@index([name])
  @@index([email])
  @@index([googleId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  BITCOIN
  OTHER
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PENDING
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  channel       SaleChannel   @default(POS)
  subtotal      Decimal       @db.Decimal(10, 2)
  ivaTotal      Decimal       @db.Decimal(10, 2) @default(0.00)
  discountTotal Decimal       @db.Decimal(10, 2) @default(0.00)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus SaleStatus    @default(COMPLETED)
  cashReceived  Decimal?      @db.Decimal(10, 2)
  cashChange    Decimal?      @db.Decimal(10, 2)
  notes         String?
  cashierName   String?       @default("Caja 1")
  customerId    String?
  customer      Customer?     @relation(fields: [customerId], references: [id])
  items         SaleItem[]
  dteDocument   DteDocument?
  shiftId       String?
  shift         CashShift?    @relation(fields: [shiftId], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([createdAt])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  ivaRate     Decimal  @db.Decimal(4, 2) @default(0.13)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}

enum DteType {
  FACTURA_01
  CREDITO_FISCAL_03
  NOTA_CREDITO_05
  SUJETO_EXCLUIDO_14
}

enum DteStatus {
  SIMULADO
  PROCESADO
  RECHAZADO
  CONTINGENCIA
  ANULADO
}

model DteDocument {
  id               String    @id @default(cuid())
  saleId           String    @unique
  sale             Sale      @relation(fields: [saleId], references: [id])
  tipoDte          DteType   @default(FACTURA_01)
  version          Int       @default(1)
  codigoGeneracion String    @unique
  numeroControl    String?
  selloRecepcion   String?
  estado           DteStatus @default(SIMULADO)
  fhProcesamiento  DateTime?
  mensajeRespuesta String?
  observaciones    String?
  requestJson      String?   @db.Text
  responseJson     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum MovementType {
  IN_PURCHASE
  OUT_SALE
  OUT_DAMAGE
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  notes         String?
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([createdAt])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id            String      @id @default(cuid())
  cashierName   String
  openedAt      DateTime    @default(now())
  closedAt      DateTime?
  initialAmount Decimal     @db.Decimal(10, 2)
  finalAmount   Decimal?    @db.Decimal(10, 2)
  totalSales    Decimal?    @db.Decimal(10, 2) @default(0.00)
  status        ShiftStatus @default(OPEN)
  sales         Sale[]
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  nit           String?
  nrc           String?
  phone         String?
  email         String?
  address       String?
  category      String?    @default("Esencias & Fragancias")
  creditDays    Int        @default(0)
  notes         String?
  purchases     Purchase[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Purchase {
  id              String            @id @default(cuid())
  purchaseNumber  String            @unique
  tipoDte         String            @default("CCF")
  supplierId      String
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  supplierName    String
  purchaseDate    DateTime          @default(now())
  dueDate         DateTime?
  creditDays      Int               @default(0)
  docNumber       String
  controlNumber   String?
  condicion       String            @default("CONTADO")
  paymentMethod   String?           @default("EFECTIVO")
  paymentStatus   String            @default("PAGADO")
  subtotalNeto    Decimal           @db.Decimal(10, 2)
  iva             Decimal           @db.Decimal(10, 2) @default(0.00)
  total           Decimal           @db.Decimal(10, 2)
  saldoPendiente  Decimal           @db.Decimal(10, 2) @default(0.00)
  notes           String?
  receptionStatus String?           @default("PENDIENTE")
  receivedAt      DateTime?
  receivedBy      String?
  items           PurchaseItem[]
  payments        PurchasePayment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  productName String
  productSku  String?
  unit        String   @default("Onza")
  quantity    Int
  costPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
}

model PurchasePayment {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("EFECTIVO")
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
}

model CustomerCredit {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creditLimit Decimal         @db.Decimal(10, 2) @default(0.00)
  balance     Decimal         @db.Decimal(10, 2) @default(0.00)
  creditDays  Int             @default(30)
  status      String          @default("ACTIVO")
  notes       String?
  payments    CreditPayment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CreditPayment {
  id            String         @id @default(cuid())
  creditId      String
  credit        CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(10, 2)
  paymentMethod String         @default("EFECTIVO")
  receiptNumber String?
  notes         String?
  createdAt     DateTime       @default(now())
}
