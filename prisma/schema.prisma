generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?   @default("folder")
  color       String?   @default("#6366f1")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  products    Product[]
}

model Product {
  id                   String               @id @default(cuid())
  sku                  String?              @unique
  barcode              String?              @unique
  name                 String
  brand                String?
  gender               String?
  unit                 String?              @default("Onza")
  description          String?
  price                Decimal              @default(3.25) @db.Decimal(10, 2)
  cost                 Decimal?             @default(1.95) @db.Decimal(10, 2)
  stock                Int                  @default(50)
  minStock             Int                  @default(10)
  imageUrl             String?
  isActive             Boolean              @default(true)
  isAvailableOnline    Boolean              @default(true)
  categoryId           String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  puesto               String?
  officialName         String?
  supplier             String?              @default("APAESA GUATEMALA")
  finishedPerfumePrice Decimal?             @db.Decimal(10, 2)
  priceHalfOunce       Decimal?             @db.Decimal(10, 2)
  stockHalf            Int                  @default(0)
  ecommerceItems       EcommerceOrderItem[]
  category             Category?            @relation(fields: [categoryId], references: [id])
  reviews              ProductReview[]
  purchaseItems        PurchaseItem[]
  saleItems            SaleItem[]
  stockMovements       StockMovement[]

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@index([brand])
  @@index([gender])
}

model Customer {
  id              String            @id @default(cuid())
  name            String
  documentType    String?           @default("DUI")
  documentNum     String?
  nrc             String?
  businessName    String?
  activityCode    String?
  activityDesc    String?
  email           String?           @unique
  phone           String?
  address         String?
  department      String?
  municipality    String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  avatarUrl       String?
  googleId        String?
  passwordHash    String?
  notes           String?
  preferredDoc    String?           @default("01")
  taxCategory     String?           @default("OTRO")
  tradeName       String?
  addresses       CustomerAddress[]
  credits         CustomerCredit[]
  ecommerceOrders EcommerceOrder[]
  reviews         ProductReview[]
  sales           Sale[]

  @@index([documentNum])
  @@index([name])
  @@index([email])
  @@index([googleId])
}

model Sale {
  id              String           @id @default(cuid())
  saleNumber      String           @unique
  channel         SaleChannel      @default(POS)
  subtotal        Decimal          @db.Decimal(10, 2)
  ivaTotal        Decimal          @default(0.00) @db.Decimal(10, 2)
  discountTotal   Decimal          @default(0.00) @db.Decimal(10, 2)
  total           Decimal          @db.Decimal(10, 2)
  paymentMethod   PaymentMethod    @default(CASH)
  paymentStatus   SaleStatus       @default(COMPLETED)
  cashReceived    Decimal?         @db.Decimal(10, 2)
  cashChange      Decimal?         @db.Decimal(10, 2)
  notes           String?
  cashierName     String?          @default("Caja 1")
  customerId      String?
  shiftId         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  orderStatus     String?          @default("COMPLETED")
  sellerName      String?
  shippingCost    Decimal?         @default(0.00) @db.Decimal(10, 2)
  tipoComprobante String?          @default("TICKET")
  dteDocument     DteDocument?
  ecommerceOrders EcommerceOrder[]
  customer        Customer?        @relation(fields: [customerId], references: [id])
  shift           CashShift?       @relation(fields: [shiftId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  shipments       Shipment[]

  @@index([saleNumber])
  @@index([createdAt])
  @@index([customerId])
  @@index([shiftId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  productId   String
  productName String
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  ivaRate     Decimal  @default(0.13) @db.Decimal(4, 2)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  puesto      String?
  unit        String?  @default("Onza")
  product     Product  @relation(fields: [productId], references: [id])
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id            String        @id @default(cuid())
  saleId        String
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?
  cashierName   String?
  shiftId       String?
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([createdAt])
}

model DteDocument {
  id               String    @id @default(cuid())
  saleId           String?   @unique
  tipoDte          DteType   @default(FACTURA_01)
  version          Int       @default(1)
  codigoGeneracion String    @unique
  numeroControl    String?
  selloRecepcion   String?
  estado           DteStatus @default(SIMULADO)
  fhProcesamiento  DateTime?
  mensajeRespuesta String?
  observaciones    String?
  requestJson      String?
  responseJson     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  sale             Sale?     @relation(fields: [saleId], references: [id])
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  reference     String?
  notes         String?
  createdAt     DateTime     @default(now())
  costPrice     Decimal?     @db.Decimal(10, 2)
  unitPrice     Decimal?     @db.Decimal(10, 2)
  userName      String?
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

model CashShift {
  id             String         @id @default(cuid())
  cashierName    String
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  initialAmount  Decimal        @db.Decimal(10, 2)
  finalAmount    Decimal?       @db.Decimal(10, 2)
  totalSales     Decimal?       @default(0.00) @db.Decimal(10, 2)
  status         ShiftStatus    @default(OPEN)
  createdAt      DateTime       @default(now())
  difference     Decimal?       @db.Decimal(10, 2)
  expectedAmount Decimal?       @db.Decimal(10, 2)
  notes          String?
  totalBitcoin   Decimal?       @default(0.00) @db.Decimal(10, 2)
  totalCard      Decimal?       @default(0.00) @db.Decimal(10, 2)
  totalCash      Decimal?       @default(0.00) @db.Decimal(10, 2)
  totalTransfer  Decimal?       @default(0.00) @db.Decimal(10, 2)
  updatedAt      DateTime       @updatedAt
  movements      CashMovement[]
  sales          Sale[]
}

model CashMovement {
  id          String    @id @default(cuid())
  shiftId     String
  type        String    @default("EGRESO")
  amount      Decimal   @db.Decimal(10, 2)
  reason      String
  performedBy String?
  createdAt   DateTime  @default(now())
  shift       CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)

  @@index([shiftId])
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  nit           String?
  nrc           String?
  phone         String?
  email         String?
  address       String?
  category      String?    @default("Esencias & Fragancias")
  creditDays    Int        @default(0)
  notes         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  purchases     Purchase[]
}

model Purchase {
  id              String            @id @default(cuid())
  purchaseNumber  String            @unique
  tipoDte         String            @default("CCF")
  supplierId      String
  supplierName    String
  purchaseDate    DateTime          @default(now())
  dueDate         DateTime?
  creditDays      Int               @default(0)
  docNumber       String
  controlNumber   String?
  condicion       String            @default("CONTADO")
  paymentMethod   String?           @default("EFECTIVO")
  paymentStatus   String            @default("PAGADO")
  subtotalNeto    Decimal           @db.Decimal(10, 2)
  iva             Decimal           @default(0.00) @db.Decimal(10, 2)
  total           Decimal           @db.Decimal(10, 2)
  saldoPendiente  Decimal           @default(0.00) @db.Decimal(10, 2)
  notes           String?
  receptionStatus String?           @default("PENDIENTE")
  receivedAt      DateTime?
  receivedBy      String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  items           PurchaseItem[]
  payments        PurchasePayment[]
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  productId   String?
  productName String
  productSku  String?
  unit        String   @default("Onza")
  quantity    Int
  costPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())
  product     Product? @relation(fields: [productId], references: [id])
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@index([purchaseId])
  @@index([productId])
}

model PurchasePayment {
  id            String   @id @default(cuid())
  purchaseId    String
  date          DateTime @default(now())
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("EFECTIVO")
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
}

model CustomerCredit {
  id          String          @id @default(cuid())
  customerId  String
  creditLimit Decimal         @default(0.00) @db.Decimal(10, 2)
  balance     Decimal         @default(0.00) @db.Decimal(10, 2)
  creditDays  Int             @default(30)
  status      String          @default("ACTIVO")
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  payments    CreditPayment[]
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model CreditPayment {
  id            String         @id @default(cuid())
  creditId      String
  amount        Decimal        @db.Decimal(10, 2)
  paymentMethod String         @default("EFECTIVO")
  receiptNumber String?
  notes         String?
  createdAt     DateTime       @default(now())
  credit        CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
}

model CustomerAddress {
  id            String   @id @default(cuid())
  customerId    String
  title         String   @default("Principal")
  recipientName String
  phone         String
  department    String
  municipality  String
  address       String
  reference     String?
  isDefault     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  customer      Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
}

model EcommerceOrder {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  customerId        String?
  customerName      String
  customerEmail     String?
  customerPhone     String
  department        String
  municipality      String
  shippingAddress   String
  deliveryReference String?
  subtotal          Decimal              @db.Decimal(10, 2)
  shippingCost      Decimal              @default(3.50) @db.Decimal(10, 2)
  total             Decimal              @db.Decimal(10, 2)
  paymentMethod     PaymentMethod        @default(CASH)
  paymentStatus     SaleStatus           @default(PENDING)
  orderStatus       EcommerceOrderStatus @default(NUEVO)
  trackingNumber    String?
  courierName       String?
  whatsappNotified  Boolean              @default(false)
  notes             String?
  saleId            String?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  customer          Customer?            @relation(fields: [customerId], references: [id])
  sale              Sale?                @relation(fields: [saleId], references: [id])
  items             EcommerceOrderItem[]
  shipments         Shipment[]

  @@index([orderNumber])
  @@index([customerId])
  @@index([saleId])
  @@index([createdAt])
  @@index([orderStatus])
}

model EcommerceOrderItem {
  id           String         @id @default(cuid())
  orderId      String
  productId    String
  productName  String
  presentation String         @default("50ml")
  unitPrice    Decimal        @db.Decimal(10, 2)
  quantity     Int            @default(1)
  total        Decimal        @db.Decimal(10, 2)
  createdAt    DateTime       @default(now())
  order        EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product        @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model Shipment {
  id             String          @id @default(cuid())
  trackingNumber String          @unique
  orderId        String?
  saleId         String?
  customerName   String
  phone          String
  address        String
  department     String
  municipality   String?
  carrier        String          @default("Mensajero Propio")
  status         ShipmentStatus  @default(PREPARING)
  orderTotal     Decimal         @db.Decimal(10, 2)
  deliveryCost   Decimal         @default(3.50) @db.Decimal(10, 2)
  deliveryNotes  String?
  deliveredAt    DateTime?
  receivedBy     String?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  order          EcommerceOrder? @relation(fields: [orderId], references: [id])
  sale           Sale?           @relation(fields: [saleId], references: [id])

  @@index([trackingNumber])
  @@index([status])
  @@index([department])
}

model ProductReview {
  id           String    @id @default(cuid())
  productId    String
  customerId   String?
  customerName String
  rating       Int       @default(5)
  comment      String
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())
  customer     Customer? @relation(fields: [customerId], references: [id])
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([customerId])
}

model ProductFormula {
  id                String   @id @default(cuid())
  name              String
  essencePercentage Decimal  @default(33.00) @db.Decimal(5, 2)
  alcoholPercentage Decimal  @default(67.00) @db.Decimal(5, 2)
  fixativeMl        Decimal  @default(1.00) @db.Decimal(5, 2)
  description       String?
  isDefault         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Promotion {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(10, 2)
  minPurchase   Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  pin          String?
  role         String    @default("CASHIER")
  cashRegister String?   @default("Caja 1")
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model AuditLog {
  id        String   @id @default(cuid())
  action    String
  userName  String
  userRole  String?
  details   String?
  ipAddress String?
  createdAt DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}

model BlogPost {
  id              String    @id @default(cuid())
  slug            String    @unique
  title           String
  excerpt         String?
  content         String
  coverImage      String?
  author          String?   @default("Equipo Aromaniak")
  category        String?   @default("General")
  tags            String?
  metaTitle       String?
  metaDescription String?
  canonicalUrl    String?
  isPublished     Boolean   @default(true)
  publishedAt     DateTime? @default(now())
  readingTimeMin  Int?      @default(3)
  viewsCount      Int       @default(0)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([slug])
  @@index([isPublished])
  @@index([category])
  @@index([publishedAt])
}

model WpMedia {
  id        Int      @id @default(autoincrement())
  mediaId   Int      @unique
  url       String
  title     String?
  mimeType  String?
  postId    String?
  createdAt DateTime @default(now())

  @@index([mediaId])
}

model Department {
  id          Int         @id
  nombreDepto String      @unique @map("nombre_depto")
  codDepto    String      @unique @map("cod_depto")
  deptoMh     String      @unique @map("depto_mh")
  createdAt   DateTime    @default(now()) @map("created_at")
  municipios  Municipio[]

  @@map("departamentos")
}

model Municipio {
  idMunicipio     Int        @id @map("id_municipio")
  nombreMunicipio String     @map("nombre_municipio")
  idDepto         Int        @map("id_depto")
  municipioMh     String     @map("municipio_mh")
  nombreMh        String     @map("nombre_mh")
  createdAt       DateTime   @default(now()) @map("created_at")
  department      Department @relation(fields: [idDepto], references: [id])

  @@index([idDepto])
  @@index([nombreMunicipio])
  @@index([municipioMh])
  @@map("municipios")
}

model MirandaInteraction {
  id                    String   @id @default(cuid())
  location              String   @default("recepcion")
  transcription         String
  summary               String
  serviceScore          Int      @default(85)
  customerSentiment     String   @default("Neutral")
  purchaseIntent        String   @default("Media")
  crossSellingAttempted Boolean  @default(false)
  crossSellingAccepted  Boolean  @default(false)
  crossSellingProduct   String?  @default("")
  interactionResult     String   @default("Consulta")
  totalSaleAmount       Decimal? @db.Decimal(10, 2)
  speakerTag            String?  @default("")
  rawJson               String?
  createdAt             DateTime @default(now())

  @@index([createdAt])
  @@index([location])
  @@map("miranda_interactions")
}

model MirandaTask {
  id             Int       @id @default(autoincrement())
  task           String
  assignee       String    @default("Personal")
  urgency        String    @default("Media")
  status         String    @default("pending")
  location       String    @default("recepcion")
  origin         String    @default("audio")
  dueDate        String?
  reminderCount  Int       @default(0)
  lastRemindedAt DateTime?
  createdAt      DateTime  @default(now())
  completedAt    DateTime?

  @@index([status])
  @@index([createdAt])
  @@map("miranda_tasks")
}

model MirandaDemand {
  id              String   @id @default(cuid())
  fragrance       String
  brand           String?
  inspirationName String?
  available       Boolean  @default(false)
  details         String?
  location        String   @default("recepcion")
  createdAt       DateTime @default(now())

  @@index([fragrance])
  @@index([createdAt])
  @@map("miranda_demands")
}

model MirandaBusinessMemory {
  id          Int      @id @default(autoincrement())
  category    String   @default("regla_negocio")
  topic       String
  instruction String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("miranda_business_memory")
}

model MirandaPendingChange {
  id              Int       @id @default(autoincrement())
  targetDb        String
  actionType      String
  description     String
  explanation     String?
  impactAnalysis  String?
  payloadJson     String?
  status          String    @default("pending_approval")
  createdAt       DateTime  @default(now())
  approvedAt      DateTime?
  confirmedAt     DateTime?
  executionResult String?

  @@index([status])
  @@map("miranda_pending_changes")
}

model DailyVisit {
  date      String   @id
  visits    Int      @default(0)
  pageViews Int      @default(0)
  mobile    Int      @default(0)
  desktop   Int      @default(0)
  tablet    Int      @default(0)
  sources   String?
  hours     String?
  updatedAt DateTime @updatedAt
  createdAt DateTime @default(now())

  @@index([date])
  @@map("daily_visits")
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  BITCOIN
  OTHER
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PENDING
}

enum DteType {
  FACTURA_01
  CREDITO_FISCAL_03
  NOTA_CREDITO_05
  SUJETO_EXCLUIDO_14
}

enum DteStatus {
  SIMULADO
  PROCESADO
  RECHAZADO
  CONTINGENCIA
  ANULADO
}

enum MovementType {
  IN_PURCHASE
  OUT_SALE
  OUT_DAMAGE
  ADJUSTMENT
  RETURN
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum EcommerceOrderStatus {
  NUEVO
  CONFIRMADO
  EN_PREPARACION
  EN_RUTA
  ENTREGADO
  CANCELADO
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}
