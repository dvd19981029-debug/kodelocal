// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Category {
  id          String    @id @default(cuid())
  name        String
  slug        String    @unique
  description String?
  icon        String?   @default("folder")
  color       String?   @default("#6366f1")
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id                 String          @id @default(cuid())
  sku                String?         @unique // Código de esencia (ej. 100, 101)
  barcode            String?         @unique
  name               String          // Nombre del contratipo (ej. 1 Million Elixir H)
  brand              String?         // Marca inspirada (ej. Paco Rabanne, Carolina Herrera)
  gender             String?         // Caballero, Dama, Unisex, Niños
  unit               String?         @default("Onza") // Onza, Unidad, Paquete, Litro
  description        String?
  price              Decimal         @db.Decimal(10, 2) @default(3.25) // Precio venta ($3.25 para esencias)
  cost               Decimal?        @db.Decimal(10, 2) @default(1.95) // Costo compra ($1.95 para esencias)
  stock              Int             @default(50)
  minStock           Int             @default(10)
  imageUrl           String?
  puesto             String?         // Ubicación física en estante de bodega (ej. A1, B3)
  isActive           Boolean         @default(true)
  isAvailableOnline  Boolean         @default(true)
  categoryId         String?
  category           Category?       @relation(fields: [categoryId], references: [id])
  saleItems          SaleItem[]
  purchaseItems      PurchaseItem[]
  stockMovements     StockMovement[]
  ecommerceItems     EcommerceOrderItem[]
  reviews            ProductReview[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([barcode])
  @@index([sku])
  @@index([name])
  @@index([brand])
  @@index([gender])
}

model Customer {
  id           String    @id @default(cuid())
  name         String
  documentType String?   @default("DUI")
  documentNum  String?
  nrc          String?
  businessName String?
  tradeName    String?   // Nombre comercial
  activityCode String?
  activityDesc String?
  taxCategory  String?   @default("OTRO") // OTRO, MEDIANO, GRANDE
  preferredDoc String?   @default("TICKET") // 01, 03, TICKET
  email        String?   @unique
  phone        String?
  address      String?
  department   String?
  municipality String?
  passwordHash String?
  googleId     String?
  avatarUrl    String?
  notes        String?
  sales           Sale[]
  credits         CustomerCredit[]
  addresses       CustomerAddress[]
  ecommerceOrders EcommerceOrder[]
  reviews         ProductReview[]
  createdAt       DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([documentNum])
  @@index([name])
  @@index([email])
  @@index([googleId])
}

enum PaymentMethod {
  CASH
  CARD
  TRANSFER
  BITCOIN
  OTHER
}

enum SaleChannel {
  POS
  ONLINE
}

enum SaleStatus {
  COMPLETED
  CANCELLED
  PENDING
}

model Sale {
  id            String        @id @default(cuid())
  saleNumber    String        @unique
  channel       SaleChannel   @default(POS)
  subtotal      Decimal       @db.Decimal(10, 2)
  ivaTotal      Decimal       @db.Decimal(10, 2) @default(0.00)
  discountTotal Decimal       @db.Decimal(10, 2) @default(0.00)
  total         Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  paymentStatus SaleStatus    @default(COMPLETED)
  cashReceived  Decimal?      @db.Decimal(10, 2)
  cashChange      Decimal?      @db.Decimal(10, 2)
  shippingCost    Decimal?      @db.Decimal(10, 2) @default(0.00)
  sellerName      String?
  cashierName     String?       @default("Caja 1")
  tipoComprobante String?       @default("TICKET") // TICKET, 01 (Factura), 03 (CCF)
  orderStatus     String?       @default("COMPLETED") // PREFACTURA, PENDING_PREPARATION, READY_AT_WINDOW, COMPLETED, CANCELLED
  notes           String?
  customerId      String?
  customer        Customer?     @relation(fields: [customerId], references: [id])
  items           SaleItem[]
  payments        SalePayment[]
  shipments       Shipment[]
  ecommerceOrders EcommerceOrder[]
  dteDocument     DteDocument?
  shiftId         String?
  shift           CashShift?    @relation(fields: [shiftId], references: [id])
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([saleNumber])
  @@index([createdAt])
  @@index([customerId])
  @@index([shiftId])
}

model SaleItem {
  id          String   @id @default(cuid())
  saleId      String
  sale        Sale     @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId   String
  product     Product  @relation(fields: [productId], references: [id])
  productName String
  unit        String?  @default("Onza")
  puesto      String?
  quantity    Int      @default(1)
  unitPrice   Decimal  @db.Decimal(10, 2)
  ivaRate     Decimal  @db.Decimal(4, 2) @default(0.13)
  total       Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([saleId])
  @@index([productId])
}

model SalePayment {
  id            String        @id @default(cuid())
  saleId        String
  sale          Sale          @relation(fields: [saleId], references: [id], onDelete: Cascade)
  amount        Decimal       @db.Decimal(10, 2)
  paymentMethod PaymentMethod @default(CASH)
  reference     String?
  notes         String?
  cashierName   String?
  shiftId       String?
  createdAt     DateTime      @default(now())

  @@index([saleId])
  @@index([createdAt])
}

enum DteType {
  FACTURA_01
  CREDITO_FISCAL_03
  NOTA_CREDITO_05
  SUJETO_EXCLUIDO_14
}

enum DteStatus {
  SIMULADO
  PROCESADO
  RECHAZADO
  CONTINGENCIA
  ANULADO
}

model DteDocument {
  id               String    @id @default(cuid())
  saleId           String    @unique
  sale             Sale      @relation(fields: [saleId], references: [id])
  tipoDte          DteType   @default(FACTURA_01)
  version          Int       @default(1)
  codigoGeneracion String    @unique
  numeroControl    String?
  selloRecepcion   String?
  estado           DteStatus @default(SIMULADO)
  fhProcesamiento  DateTime?
  mensajeRespuesta String?
  observaciones    String?
  requestJson      String?   @db.Text
  responseJson     String?   @db.Text
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

enum MovementType {
  IN_PURCHASE
  OUT_SALE
  OUT_DAMAGE
  ADJUSTMENT
  RETURN
}

model StockMovement {
  id            String       @id @default(cuid())
  productId     String
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  type          MovementType
  quantity      Int
  previousStock Int
  newStock      Int
  costPrice     Decimal?     @db.Decimal(10, 2)
  unitPrice     Decimal?     @db.Decimal(10, 2)
  reference     String?
  notes         String?
  userName      String?
  createdAt     DateTime     @default(now())

  @@index([productId])
  @@index([type])
  @@index([createdAt])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

model CashShift {
  id             String         @id @default(cuid())
  cashierName    String
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  initialAmount  Decimal        @db.Decimal(10, 2) // Fondo inicial de caja
  finalAmount    Decimal?       @db.Decimal(10, 2) // Monto físico contado al cerrar
  expectedAmount Decimal?       @db.Decimal(10, 2) // Monto esperado según sistema
  difference     Decimal?       @db.Decimal(10, 2) // Faltante (-) o Sobrante (+)
  totalSales     Decimal?       @db.Decimal(10, 2) @default(0.00)
  totalCash      Decimal?       @db.Decimal(10, 2) @default(0.00) // Ventas en efectivo
  totalCard      Decimal?       @db.Decimal(10, 2) @default(0.00) // Ventas con tarjeta
  totalTransfer  Decimal?       @db.Decimal(10, 2) @default(0.00) // Ventas con transferencia
  totalBitcoin   Decimal?       @db.Decimal(10, 2) @default(0.00) // Ventas con Bitcoin
  status         ShiftStatus    @default(OPEN)
  notes          String?
  sales          Sale[]
  movements      CashMovement[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

model CashMovement {
  id          String    @id @default(cuid())
  shiftId     String
  shift       CashShift @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  type        String    @default("EGRESO") // INGRESO, EGRESO
  amount      Decimal   @db.Decimal(10, 2)
  reason      String
  performedBy String?
  createdAt   DateTime  @default(now())

  @@index([shiftId])
}

model Supplier {
  id            String     @id @default(cuid())
  name          String
  contactPerson String?
  nit           String?
  nrc           String?
  phone         String?
  email         String?
  address       String?
  category      String?    @default("Esencias & Fragancias")
  creditDays    Int        @default(0)
  notes         String?
  purchases     Purchase[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
}

model Purchase {
  id              String            @id @default(cuid())
  purchaseNumber  String            @unique
  tipoDte         String            @default("CCF")
  supplierId      String
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  supplierName    String
  purchaseDate    DateTime          @default(now())
  dueDate         DateTime?
  creditDays      Int               @default(0)
  docNumber       String
  controlNumber   String?
  condicion       String            @default("CONTADO")
  paymentMethod   String?           @default("EFECTIVO")
  paymentStatus   String            @default("PAGADO")
  subtotalNeto    Decimal           @db.Decimal(10, 2)
  iva             Decimal           @db.Decimal(10, 2) @default(0.00)
  total           Decimal           @db.Decimal(10, 2)
  saldoPendiente  Decimal           @db.Decimal(10, 2) @default(0.00)
  notes           String?
  receptionStatus String?           @default("PENDIENTE")
  receivedAt      DateTime?
  receivedBy      String?
  items           PurchaseItem[]
  payments        PurchasePayment[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
}

model PurchaseItem {
  id          String   @id @default(cuid())
  purchaseId  String
  purchase    Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product? @relation(fields: [productId], references: [id])
  productName String
  productSku  String?
  unit        String   @default("Onza")
  quantity    Int
  costPrice   Decimal  @db.Decimal(10, 2)
  subtotal    Decimal  @db.Decimal(10, 2)
  createdAt   DateTime @default(now())

  @@index([purchaseId])
  @@index([productId])
}

model PurchasePayment {
  id            String   @id @default(cuid())
  purchaseId    String
  purchase      Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  date          DateTime @default(now())
  amount        Decimal  @db.Decimal(10, 2)
  paymentMethod String   @default("EFECTIVO")
  reference     String?
  notes         String?
  createdAt     DateTime @default(now())
}

model CustomerCredit {
  id          String          @id @default(cuid())
  customerId  String
  customer    Customer        @relation(fields: [customerId], references: [id], onDelete: Cascade)
  creditLimit Decimal         @db.Decimal(10, 2) @default(0.00)
  balance     Decimal         @db.Decimal(10, 2) @default(0.00)
  creditDays  Int             @default(30)
  status      String          @default("ACTIVO")
  notes       String?
  payments    CreditPayment[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
}

model CreditPayment {
  id            String         @id @default(cuid())
  creditId      String
  credit        CustomerCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  amount        Decimal        @db.Decimal(10, 2)
  paymentMethod String         @default("EFECTIVO")
  receiptNumber String?
  notes         String?
  createdAt     DateTime       @default(now())
}

model CustomerAddress {
  id            String    @id @default(cuid())
  customerId    String
  customer      Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  title         String    @default("Principal")
  recipientName String
  phone         String
  department    String
  municipality  String
  address       String
  reference     String?
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([customerId])
}

enum EcommerceOrderStatus {
  NUEVO
  CONFIRMADO
  EN_PREPARACION
  EN_RUTA
  ENTREGADO
  CANCELADO
}

model EcommerceOrder {
  id                String               @id @default(cuid())
  orderNumber       String               @unique
  customerId        String?
  customer          Customer?            @relation(fields: [customerId], references: [id])
  customerName      String
  customerEmail     String?
  customerPhone     String
  department        String
  municipality      String
  shippingAddress   String
  deliveryReference String?
  subtotal          Decimal              @db.Decimal(10, 2)
  shippingCost      Decimal              @db.Decimal(10, 2) @default(3.50)
  total             Decimal              @db.Decimal(10, 2)
  paymentMethod     PaymentMethod        @default(CASH)
  paymentStatus     SaleStatus           @default(PENDING)
  orderStatus       EcommerceOrderStatus @default(NUEVO)
  trackingNumber    String?
  courierName       String?
  whatsappNotified  Boolean              @default(false)
  notes             String?
  items             EcommerceOrderItem[]
  shipments         Shipment[]
  saleId            String?
  sale              Sale?                @relation(fields: [saleId], references: [id])
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt

  @@index([orderNumber])
  @@index([customerId])
  @@index([saleId])
  @@index([createdAt])
  @@index([orderStatus])
}

model EcommerceOrderItem {
  id           String         @id @default(cuid())
  orderId      String
  order        EcommerceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId    String
  product      Product        @relation(fields: [productId], references: [id])
  productName  String
  presentation String         @default("50ml")
  unitPrice    Decimal        @db.Decimal(10, 2)
  quantity     Int            @default(1)
  total        Decimal        @db.Decimal(10, 2)
  createdAt    DateTime       @default(now())

  @@index([orderId])
  @@index([productId])
}

enum ShipmentStatus {
  PREPARING
  IN_TRANSIT
  DELIVERED
  FAILED
  RETURNED
}

model Shipment {
  id             String         @id @default(cuid())
  trackingNumber String         @unique
  orderId        String?
  order          EcommerceOrder? @relation(fields: [orderId], references: [id])
  saleId         String?
  sale           Sale?          @relation(fields: [saleId], references: [id])
  customerName   String
  phone          String
  address        String
  department     String
  municipality   String?
  carrier        String         @default("Mensajero Propio") // Mensajero Propio, Cargo Expreso, etc.
  status         ShipmentStatus @default(PREPARING)
  orderTotal     Decimal        @db.Decimal(10, 2)
  deliveryCost   Decimal        @db.Decimal(10, 2) @default(3.50)
  deliveryNotes  String?
  deliveredAt    DateTime?
  receivedBy     String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([trackingNumber])
  @@index([status])
  @@index([department])
}

model ProductReview {
  id           String    @id @default(cuid())
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  customerId   String?
  customer     Customer? @relation(fields: [customerId], references: [id])
  customerName String
  rating       Int       @default(5)
  comment      String
  isApproved   Boolean   @default(true)
  createdAt    DateTime  @default(now())

  @@index([productId])
  @@index([customerId])
}

model ProductFormula {
  id                String   @id @default(cuid())
  name              String   // Ej: "Fórmula de Lujo 33% Fijación"
  essencePercentage Decimal  @db.Decimal(5, 2) @default(33.00)
  alcoholPercentage Decimal  @db.Decimal(5, 2) @default(67.00)
  fixativeMl        Decimal  @db.Decimal(5, 2) @default(1.00)
  description       String?
  isDefault         Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
  FREE_SHIPPING
}

model Promotion {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType @default(PERCENTAGE)
  discountValue Decimal      @db.Decimal(10, 2)
  minPurchase   Decimal?     @db.Decimal(10, 2)
  maxUses       Int?
  usedCount     Int          @default(0)
  startDate     DateTime?
  endDate       DateTime?
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([code])
}

model StaffUser {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  pin          String?   // PIN de 4 dígitos para caja
  role         String    @default("CASHIER") // ADMIN, CASHIER, BODEGA, DESPACHO
  cashRegister String?   @default("Caja 1")
  isActive     Boolean   @default(true)
  lastLogin    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([email])
}

model AuditLog {
  id          String   @id @default(cuid())
  action      String   // AJUSTE_STOCK, ANULACION_VENTA, CAMBIO_PRECIO, CORTE_CAJA
  userName    String
  userRole    String?
  details     String?  @db.Text
  ipAddress   String?
  createdAt   DateTime @default(now())

  @@index([action])
  @@index([createdAt])
}
